# (production|development) Specifies the environment DropIn is running in
NODE_ENV=development

# (1-65535) The port DropIn listens on (8080 is recommended for Docker deployments)
PORT=8080

# ([URL]) The base URL that DropIn will be served on
VITE_SOCKET_URL=http://localhost:8080

# (debug|info|warn|error) Sets the database logging level
DB_LOG_LEVEL=debug
# (debug|info|warn|error) Sets the console logging level
CONSOLE_LOG_LEVEL=debug

# (>0) Maximum number of messages returned in a single page request
PAGE_SIZE=250

# (age|count|none) Determines the maximum retention strategy for messages in the database
MESSAGE_PRUNING_STRATEGY=age
# (>0) Maximum age (in days) or number of old messages to retain, depending on the pruning strategy
MESSAGE_PRUNING_LIMIT=90

# (age|count|none) Determines the maximum retention strategy for logs in the database
LOG_PRUNING_STRATEGY=age
# (>0) Maximum age (in days) or number of old logs to retain, depending on the pruning strategy
LOG_PRUNING_LIMIT=90

# How often (in hours) the database is cleaned up by removing old messages and logs
DB_CLEANUP_INTERVAL=24
