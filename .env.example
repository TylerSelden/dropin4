# Tells DropIn what environment it's running in
NODE_ENV=production

# The port that DropIn will run on
PORT=8080

# The URL that DropIn will be served on
VITE_SOCKET_URL=https://example.com

# Logging levels for database and console output
# Options: debug, info, warn, error
DB_LOG_LEVEL=warn
CONSOLE_LOG_LEVEL=warn

# The maximum number of messages to return in a single page request
PAGE_SIZE=250

# The strategy for removing old messages and logs from the database (age is in days)
# Options: age, count, none
MESSAGE_PRUNING_STRATEGY=age
MESSAGE_PRUNING_LIMIT=90

LOG_PRUNING_STRATEGY=age
LOG_PRUNING_LIMIT=90

# How often the database should be pruned of old messages and logs (in hours)
DB_CLEANUP_INTERVAL=24
